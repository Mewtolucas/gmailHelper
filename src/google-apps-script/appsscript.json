{
  "timeZone": "America/New_York",
  "dependencies": {},
  "exceptionLogging": "STACKDRIVER",
  "runtimeVersion": "V8",
  "addOns": {
    "gmail": {
      "name": "Gmail Helper",
      "description": "Smart email categorization, prioritization, and management",
      "version": "1.0",
      "logoUrl": "https://fonts.gstatic.com/s/i/googlematerialui/mail/v8/black-48dp.png",
      "homepageTrigger": {
        "runFunction": "showSidebar"
      }
    }
  },
  "oauthScopes": [
    "https://www.googleapis.com/auth/gmail.modify",
    "https://www.googleapis.com/auth/gmail.readonly",
    "https://www.googleapis.com/auth/script.properties"
  ]
}
