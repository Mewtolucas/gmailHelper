{
  "name": "gmail-helper",
  "version": "1.0.0",
  "description": "Comprehensive Gmail management application with AI-powered categorization and smart filtering",
  "main": "dist/src/index.js",
  "bin": {
    "gmail-helper": "dist/src/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/cli/index.js",
    "dev": "ts-node src/cli/index.ts",
    "server": "ts-node src/server/index.ts",
    "server:prod": "node dist/src/server/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist node_modules"
  },
  "keywords": [
    "gmail",
    "email",
    "categorization",
    "ai",
    "management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^118.0.0",
    "google-auth-library": "^9.4.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
